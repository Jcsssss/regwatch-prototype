# OS
.DS_Store

# Build artifacts — regenerate with src/build.sh
src/bundle.js
src/regwatch-artifact.html
src/regwatch.html
src/test_*.html

# Knowledge graph — regenerate with `graphify update .`
graphify-out/

# Python
venv/
.venv/
__pycache__/
*.pyc

# Credentials — never commit. Azure OpenAI keys for the watch agent live in a
# .env that stays on the machine that runs the agent.
.env
.env.*
*.env
!.env.example

# Internal Wavestone material and heavy media — kept local on purpose.
# Real client data (KPI workbook), internal decks and the brand charter must not
# be pushed without an explicit go from the team.
#
# The folder itself is tracked (its README says what belongs in it) but nothing
# inside it is. That matters here more than usual: GitHub Pages serves the whole
# repository tree, so a file committed under ressources/ would be downloadable
# at a public URL. To push one deliberately: git add -f ressources/<file>
ressources/*
!ressources/README.md
*.mp4
*.pptx

# Generated country decks
out/

# Runtime artifact: importing the watch agent creates this in the CWD
logs/

# Graph token cache and the workbook pulled from SharePoint.
# graph-token.json holds a refresh token — a credential, never commit it.
data/.cache/

# Azure Function proxy: local settings hold the key
azure-proxy/local.settings.json
azure-proxy/.python_packages/

# Version equipe : rebâtie en une commande (zsh src/build.sh), et elle ne doit
# pas etre servie par GitHub Pages - la page publique est la version client.
regwatch-equipe.html
src/regwatch-equipe.html
src/artifact-equipe.html
src/bundle-equipe.js
src/shell_client.html
