# OS
.DS_Store

# Build artifacts — regenerate with src/build.sh
src/bundle.js
src/regwatch-artifact.html
src/regwatch.html
src/test_*.html

# Knowledge graph — regenerate with `graphify update .`
graphify-out/

# Python
venv/
.venv/
__pycache__/
*.pyc

# Credentials — never commit. Azure OpenAI keys for the watch agent live in a
# .env that stays on the machine that runs the agent.
.env
.env.*
*.env
!.env.example

# Internal Wavestone material and heavy media — kept local on purpose.
# Real client data (KPI workbook), internal decks and the brand charter must not
# be pushed without an explicit go from the team.
ressources/
*.mp4
*.pptx

# Generated country decks
out/

# Runtime artifact: importing the watch agent creates this in the CWD
logs/

# Graph token cache and the workbook pulled from SharePoint.
# graph-token.json holds a refresh token — a credential, never commit it.
data/.cache/
