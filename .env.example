# Gabarit de configuration pour la synchro SharePoint (lecture seule).
# Copier en .env — le vrai fichier n'est jamais commité.

# Le lien « Copier le lien » du classeur dans SharePoint.
SHAREPOINT_FILE_URL=

# Facultatif : déduit du lien si absent.
# Retrouvable avec : ./venv/bin/python tools/sharepoint_fetch.py --check "<lien>"
GRAPH_TENANT_ID=

